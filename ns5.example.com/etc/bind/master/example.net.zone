$TTL    3600
@       IN      SOA     ns5.example.com. admin.example.net. (
                              1         ; Serial
                         604800         ; Refresh
                          86400         ; Retry
                        2419200         ; Expire
                         604800 )       ; Negative Cache TTL
;
@       IN      NS      ns5.example.com.
@       IN      NS      ns6.example.com.

; A записи для серверов имен
; ns5     IN      A       172.28.5.5
; ns6     IN      A       172.28.6.6

