$TTL    3600
@       IN      SOA     ns4.example.com. admin.example.com. (
                              1         ; (Serial)Серийный номер
                         604800         ; (Refresh)Период обновления (1 неделя)
                          86400         ; (Retry)Период попытки повтора (1 день)
                        2419200         ; (Expire)Время истечения (4 недели)
                         604800 )       ; (Negative Cache TTL)Отрицательный кеш TTL (1 неделя)
;
@       IN      NS      ns4.example.com.
@       IN      NS      ns5.example.com.
@       IN      NS      ns6.example.com.

; A записи для серверов имен
ns4     IN      A       172.28.4.4
ns5     IN      A       172.28.5.5
ns6     IN      A       172.28.6.6
